#!/usr/bin/env python3
"""jev-gate: old name of decisions-gate (renamed 2026-11-19). Runs decisions-gate with the same arguments and stdin,
so hooks, scripts and prompts that call jev-gate keep working. Old [jev: ...] / [jev-override: ...] tags are accepted."""
import os, sys
from pathlib import Path

target = Path(__file__).resolve().parent / "decisions-gate"
if not target.exists():
    print(f"jev-gate: {target} is missing; install decisions-gate next to this wrapper.", file=sys.stderr)
    sys.exit(3)
args = [sys.executable, str(target), *sys.argv[1:]]
if os.name == "nt":
    # subprocess quotes Windows argv correctly; the CRT exec family does not.
    import subprocess
    sys.exit(subprocess.call(args))
os.execv(sys.executable, args)
